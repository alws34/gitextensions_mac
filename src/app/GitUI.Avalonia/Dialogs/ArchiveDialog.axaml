<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.ArchiveDialog"
                            Title="Archive Repository" Width="450">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Format:" />
        <ComboBox x:Name="FormatCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
            <ComboBoxItem Content="zip" />
            <ComboBoxItem Content="tar" />
            <ComboBoxItem Content="tar.gz" />
        </ComboBox>
        <TextBlock Text="Commit / tag (default: HEAD):" />
        <TextBox x:Name="CommitTextBox" />
        <TextBlock Text="Output file path:" />
        <Grid ColumnDefinitions="*,4,Auto">
            <TextBox Grid.Column="0" x:Name="OutputPathTextBox" />
            <Button Grid.Column="2" Content="Browse..." Click="Browse_Click" />
        </Grid>
        <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Archive" IsDefault="True" Click="OK_Click" />
        </StackPanel>
    </StackPanel>
</local:GitExtensionsDialog>
