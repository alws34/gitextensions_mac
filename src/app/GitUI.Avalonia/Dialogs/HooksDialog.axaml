<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.HooksDialog"
                            Title="Git Hooks" Width="680" Height="480">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="200,8,*">
            <!-- Hooks list -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" x:Name="HooksList" SelectionChanged="HooksList_SelectionChanged" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                    <Button Content="Enable"  Click="Enable_Click" />
                    <Button Content="Disable" Click="Disable_Click" />
                </StackPanel>
            </Grid>

            <!-- Hook editor -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" x:Name="HookStatusLabel" Margin="0,0,0,4" />
                <TextBox Grid.Row="1" x:Name="HookEditor"
                         AcceptsReturn="True"
                         FontFamily="{DynamicResource MonospaceFont}"
                         FontSize="12" />
                <Button Grid.Row="2" Content="Save Hook" Click="SaveHook_Click"
                        HorizontalAlignment="Right" Margin="0,4,0,0" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</local:GitExtensionsDialog>
