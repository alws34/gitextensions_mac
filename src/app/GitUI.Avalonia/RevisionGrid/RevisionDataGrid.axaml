<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GitUI.Avalonia.RevisionGrid"
             xmlns:git="using:GitExtensions.Extensibility.Git"
             x:Class="GitUI.Avalonia.RevisionGrid.RevisionDataGrid">
    <DockPanel>
        <!-- Column headers: Graph | Subject(*) | Author(140) | Date(100) | Hash(72) -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="80,*,140,100,72"
              Background="{DynamicResource SystemChromeMediumColor}"
              Height="24">
            <!-- Bottom border separator -->
            <Border Grid.Column="0" Grid.ColumnSpan="5"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" />

            <!-- Graph header -->
            <TextBlock Grid.Column="0" Text="Graph"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
            <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right"
                       Fill="{DynamicResource SystemBaseMediumLowColor}" />

            <!-- Subject header -->
            <TextBlock Grid.Column="1" Text="Subject"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
            <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right"
                       Fill="{DynamicResource SystemBaseMediumLowColor}" />

            <!-- Author header -->
            <TextBlock Grid.Column="2" Text="Author"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
            <Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Right"
                       Fill="{DynamicResource SystemBaseMediumLowColor}" />

            <!-- Date header -->
            <TextBlock Grid.Column="3" Text="Date"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
            <Rectangle Grid.Column="3" Width="1" HorizontalAlignment="Right"
                       Fill="{DynamicResource SystemBaseMediumLowColor}" />

            <!-- Hash header -->
            <TextBlock Grid.Column="4" Text="Hash"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
        </Grid>

        <ListBox x:Name="CommitList"
                 SelectionMode="Single"
                 SelectionChanged="CommitList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ContextMenu>
                <ContextMenu Opening="CommitContextMenu_Opening">
                    <MenuItem Header="Checkout this commit" Click="CtxCheckout_Click" />
                    <MenuItem Header="Cherry-pick…"         Click="CtxCherryPick_Click" />
                    <MenuItem Header="Revert…"              Click="CtxRevert_Click" />
                    <Separator />
                    <MenuItem Header="Create Branch here…"  Click="CtxCreateBranch_Click" />
                    <MenuItem Header="Create Tag here…"     Click="CtxCreateTag_Click" />
                    <Separator />
                    <MenuItem Header="Reset to this (hard)" Click="CtxResetHard_Click" />
                    <Separator />
                    <MenuItem Header="Copy commit hash"     Click="CtxCopyHash_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:RevisionRow">
                    <!-- Row height exactly 22px; column order: Graph(80) | Subject(*) | Author(140) | Date(100) | Hash(72) -->
                    <Grid ColumnDefinitions="80,*,140,100,72" Height="22">

                        <!-- Graph column -->
                        <local:GraphCell Grid.Column="0"
                                         Row="{Binding GraphRow}"
                                         PrevRow="{Binding PrevRow}"
                                         NextRow="{Binding NextRow}"
                                         Width="80" Height="22" />

                        <!-- Subject: colored ref badges + message text -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="4"
                                    Margin="4,0">
                            <ItemsControl ItemsSource="{Binding Refs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="git:IGitRef">
                                        <Border Background="{Binding ., Converter={StaticResource RefTypeBrush}}"
                                                CornerRadius="2"
                                                Padding="3,1">
                                            <TextBlock Text="{Binding LocalName}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Subject}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Author column -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Author}"
                                   VerticalAlignment="Center"
                                   Margin="4,0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Date column: date only, no time -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding AuthorDate, StringFormat='{}{0:yyyy-MM-dd}'}"
                                   VerticalAlignment="Center"
                                   Margin="4,0"
                                   FontSize="11" />

                        <!-- Hash column: 7-char monospace, adaptive gray -->
                        <TextBlock Grid.Column="4"
                                   Text="{Binding ShortHash}"
                                   VerticalAlignment="Center"
                                   Margin="4,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                   FontFamily="{DynamicResource MonospaceFont}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
