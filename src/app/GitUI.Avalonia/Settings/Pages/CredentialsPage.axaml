<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.Avalonia.Settings.Pages.CredentialsPage">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Credentials" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />

        <!-- Credential helper -->
        <StackPanel Spacing="4">
            <TextBlock Text="Git credential helper:" />
            <ComboBox x:Name="CredentialHelperComboBox" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Default" Tag="" />
                <ComboBoxItem Content="osxkeychain" Tag="osxkeychain" />
                <ComboBoxItem Content="store" Tag="store" />
                <ComboBoxItem Content="manager" Tag="manager" />
            </ComboBox>
        </StackPanel>

        <!-- Default username -->
        <StackPanel Spacing="4">
            <TextBlock Text="Default username:" />
            <TextBox x:Name="UsernameTextBox" Watermark="your-username" />
        </StackPanel>

        <!-- Configure now -->
        <Button Content="Configure now" Click="ConfigureNow_Click" HorizontalAlignment="Left" Padding="8,3" />
        <TextBlock x:Name="ConfigureResultLabel"
                   FontSize="11"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
