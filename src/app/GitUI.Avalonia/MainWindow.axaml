<local:GitExtensionsWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GitUI.Avalonia.Base"
    xmlns:dashboard="using:GitUI.Avalonia.Dashboard"
    xmlns:controls="using:GitUI.Avalonia.Controls"
    xmlns:grid="using:GitUI.Avalonia.RevisionGrid"
    xmlns:details="using:GitUI.Avalonia.CommitDetails"
    xmlns:leftpanel="using:GitUI.Avalonia.LeftPanel"
    x:Class="GitUI.Avalonia.MainWindow"
    Title="Git Extensions"
    Width="1280" Height="800"
    MinWidth="1024" MinHeight="600">

    <DockPanel>
        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top" x:Name="MainMenu" />

        <!-- Tool bar -->
        <Border DockPanel.Dock="Top" Height="32"
                Background="{DynamicResource SystemChromeMediumColor}">
            <StackPanel x:Name="MainToolBar" Orientation="Horizontal" Spacing="2" Margin="4,2" />
        </Border>

        <!-- Filter bar (only visible when a repo is open) -->
        <controls:FilterToolBar DockPanel.Dock="Top" x:Name="FilterBar"
                                IsVisible="{Binding HasRepository}" />

        <!-- In-progress action banner (merge / cherry-pick / etc.) -->
        <Border DockPanel.Dock="Top"
                x:Name="ActionBar"
                Background="#FFFFF3CD"
                BorderBrush="#FFFFE082"
                BorderThickness="0,0,0,1"
                IsVisible="False"
                Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Padding="4,2"
                        Click="ActionBar_Dismiss"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip.Tip="Dismiss" />
                <Button DockPanel.Dock="Right"
                        x:Name="ActionBar_AbortBtn"
                        Padding="8,2"
                        Margin="0,0,4,0"
                        FontSize="11"
                        Click="ActionBar_Abort" />
                <TextBlock x:Name="ActionBarText"
                           VerticalAlignment="Center"
                           FontSize="12" />
            </DockPanel>
        </Border>

        <!-- Status bar at the very bottom -->
        <Border DockPanel.Dock="Bottom"
                MinHeight="22"
                Background="{DynamicResource SystemChromeMediumColor}"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                Padding="8,3">
            <DockPanel>
                <TextBlock x:Name="StatusLabel"
                           DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontFamily="{DynamicResource MonospaceFont}"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <TextBlock x:Name="BranchLabel"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#FF2E7D32" />
                <TextBlock x:Name="AheadBehindLabel"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="8,0,0,0"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           IsVisible="False" />
                <TextBlock x:Name="StagedCountLabel"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="8,0,0,0"
                           Foreground="#FF1565C0"
                           IsVisible="False" />
                <TextBlock x:Name="UnstagedCountLabel"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Margin="8,0,0,0"
                           Foreground="#FFE65100"
                           IsVisible="False" />
            </DockPanel>
        </Border>

        <!-- Main content area -->
        <Grid>
            <!-- No-repo dashboard -->
            <dashboard:DashboardView x:Name="Dashboard"
                                     IsVisible="{Binding !HasRepository}" />

            <!-- Repo view: [left panel | splitter | revision grid] / [splitter] / [commit details] -->
            <Grid x:Name="RepoView" IsVisible="{Binding HasRepository}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="250" MinHeight="100" />
                </Grid.RowDefinitions>

                <!-- Top row: left panel + revision grid side by side -->
                <Grid Grid.Row="0" x:Name="TopContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="0" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <leftpanel:RepoBrowserPanel Grid.Column="0" x:Name="LeftPanel"
                                                Background="{DynamicResource SystemChromeMediumLowColor}" />
                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
                    <grid:RevisionGridControl Grid.Column="2" x:Name="RevisionGrid" />
                </Grid>

                <!-- Horizontal splitter between grid and details -->
                <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                <!-- Bottom row: commit details panel -->
                <details:CommitDetailsPanel Grid.Row="2" x:Name="DetailsPanel" />
            </Grid>
        </Grid>
    </DockPanel>

</local:GitExtensionsWindow>
