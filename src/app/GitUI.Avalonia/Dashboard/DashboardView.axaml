<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.Avalonia.Dashboard.DashboardView">
    <Grid RowDefinitions="Auto,*">

        <!-- Row 0: App header bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemChromeMediumColor}"
                BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="Mac Edition"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Git Extensions"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Row 1: Two-column split -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*">

            <!-- Left panel: Recent Repositories -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <TextBlock Grid.Row="0"
                               Text="Recent Repositories"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="16,16,16,8" />

                    <ListBox Grid.Row="1"
                             x:Name="RecentList"
                             SelectionChanged="RecentList_SelectionChanged"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="4,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="📁"
                                               Width="20"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,6" />
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                    </ListBox>

                    <!-- Browse link at the bottom -->
                    <Button Grid.Row="2"
                            Content="Browse for repository…"
                            Click="BrowseButton_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource SystemAccentColor}"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            Margin="12,4,12,12"
                            Padding="4,4" />
                </Grid>
            </Border>

            <!-- Right panel: Actions -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SystemChromeMediumColor}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16"
                            Width="260">

                    <TextBlock Text="Start"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               Margin="0,0,0,4" />

                    <Button Content="📂  Open Repository…"
                            Width="220"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Classes="accent"
                            Click="OpenButton_Click" />

                    <Button Content="⎘   Clone Repository…"
                            Width="220"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Click="CloneButton_Click" />

                    <Button Content="＋  Init New Repository…"
                            Width="220"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Click="InitButton_Click" />

                    <Border Height="1"
                            Background="{DynamicResource SystemBaseMediumLowColor}"
                            Margin="0,8" />

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
