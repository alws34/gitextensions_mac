<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.MergeBranchDialog"
                            Title="Merge Branch" Width="420">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Branch to merge:" />
        <ComboBox x:Name="BranchComboBox" HorizontalAlignment="Stretch" />
        <TextBlock Text="Strategy:" />
        <RadioButton x:Name="FastForwardRadio" Content="Fast-forward only (--ff-only)" IsChecked="True" GroupName="MergeStrategy" />
        <RadioButton x:Name="NoFastForwardRadio" Content="No fast-forward (--no-ff)" GroupName="MergeStrategy" />
        <RadioButton x:Name="SquashRadio" Content="Squash (--squash)" GroupName="MergeStrategy" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Merge" IsDefault="True" Click="OK_Click" />
        </StackPanel>
    </StackPanel>
</local:GitExtensionsDialog>
