<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.ScriptsManagerDialog"
                            Title="User Scripts" Width="620" Height="440">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <Grid Grid.Row="0" ColumnDefinitions="200,8,*">
            <!-- Scripts list -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" x:Name="ScriptsList" SelectionChanged="ScriptsList_SelectionChanged" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                    <Button Content="Add"    Click="Add_Click" />
                    <Button Content="Remove" Click="Remove_Click" />
                </StackPanel>
            </Grid>

            <!-- Script editor -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="Name:" Margin="0,0,0,2" />
                <TextBox Grid.Row="1" x:Name="NameBox" Margin="0,0,0,8" />
                <TextBlock Grid.Row="2" Text="Command (use {hash} for current commit hash, {repo} for repo path):" Margin="0,0,0,2" />
                <TextBox Grid.Row="3" x:Name="CommandBox" Margin="0,0,0,8" />
                <TextBlock Grid.Row="4" Text="Run button executes the script in the repository directory."
                           TextWrapping="Wrap" Foreground="Gray" FontSize="11" />
                <Button Grid.Row="5" Content="Run Script Now" Click="Run_Click"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Save" Click="Save_Click" />
                <Button Content="Close" Click="Close_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</local:GitExtensionsDialog>
