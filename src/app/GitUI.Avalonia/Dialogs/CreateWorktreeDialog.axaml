<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.CreateWorktreeDialog"
                            Title="Create Worktree" Width="450">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Worktree path:" />
        <Grid ColumnDefinitions="*,4,Auto">
            <TextBox Grid.Column="0" x:Name="PathTextBox" />
            <Button Grid.Column="2" Content="Browse..." Click="Browse_Click" />
        </Grid>
        <TextBlock Text="Branch:" />
        <TextBox x:Name="BranchTextBox" />
        <CheckBox x:Name="NewBranchCheckBox" Content="Create new branch (-b)" />
        <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Create" IsDefault="True" Click="OK_Click" />
        </StackPanel>
    </StackPanel>
</local:GitExtensionsDialog>
