<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.DeleteBranchDialog"
                            Title="Delete Branch" Width="400" Height="350">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="Select branches to delete:" Margin="0,0,0,4" />
            <CheckBox DockPanel.Dock="Top" x:Name="ForceCheckBox" Content="Force delete" Margin="0,0,0,4" />
            <ListBox x:Name="BranchList" SelectionMode="Multiple" />
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Delete" IsDefault="True" Click="OK_Click" />
        </StackPanel>
    </Grid>
</local:GitExtensionsDialog>
