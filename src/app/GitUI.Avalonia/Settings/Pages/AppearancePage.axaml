<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.Avalonia.Settings.Pages.AppearancePage">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Appearance" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBlock Text="Editor font family:" />
        <TextBox x:Name="EditorFontTextBox" />
        <TextBlock Text="Editor font size:" />
        <NumericUpDown x:Name="EditorFontSizeBox" Minimum="8" Maximum="24" Increment="1" />
    </StackPanel>
</UserControl>
