<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.AddToGitIgnoreDialog"
                            Title="Add to .gitignore" Width="420">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="Pattern to ignore:"/>
    <TextBox x:Name="PatternBox"/>
    <TextBlock Text="Target:"/>
    <ComboBox x:Name="TargetCombo">
      <ComboBoxItem Content="Repository (.gitignore)"/>
      <ComboBoxItem Content="Global (~/.gitignore_global)"/>
    </ComboBox>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Add" Click="Add_Click"/>
      <Button Content="Cancel" Click="Cancel_Click"/>
    </StackPanel>
  </StackPanel>
</local:GitExtensionsDialog>
