<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GitUI.Avalonia.RevisionGrid"
             xmlns:git="using:GitExtensions.Extensibility.Git"
             x:Class="GitUI.Avalonia.RevisionGrid.RevisionDataGrid">
    <DockPanel>
        <!-- Column headers with drag-resizable GridSplitters -->
        <!-- Col layout: 0=Graph 1=Splitter 2=Subject(*) 3=Splitter 4=Author 5=Splitter 6=Date 7=Splitter 8=Hash -->
        <Grid DockPanel.Dock="Top"
              x:Name="HeaderGrid"
              ColumnDefinitions="80,4,*,4,120,4,100,4,68"
              Background="{DynamicResource SystemChromeMediumColor}"
              Height="22">
            <Border Grid.Column="0" Grid.ColumnSpan="9"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                    BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" />

            <TextBlock Grid.Column="0" Text="Graph"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
            <GridSplitter Grid.Column="1"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWestEast"
                          Background="{DynamicResource SystemBaseMediumLowColor}" />

            <TextBlock Grid.Column="2" Text="Subject"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWestEast"
                          Background="{DynamicResource SystemBaseMediumLowColor}" />

            <TextBlock Grid.Column="4" Text="Author"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
            <GridSplitter Grid.Column="5"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWestEast"
                          Background="{DynamicResource SystemBaseMediumLowColor}" />

            <TextBlock Grid.Column="6" Text="Date"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
            <GridSplitter Grid.Column="7"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Cursor="SizeWestEast"
                          Background="{DynamicResource SystemBaseMediumLowColor}" />

            <TextBlock Grid.Column="8" Text="Hash"
                       FontSize="11" FontWeight="SemiBold"
                       Margin="4,0" VerticalAlignment="Center" />
        </Grid>

        <ListBox x:Name="CommitList"
                 SelectionMode="Single"
                 SelectionChanged="CommitList_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ContextMenu>
                <ContextMenu x:Name="CommitContextMenu"
                             Opening="CommitContextMenu_Opening">
                    <MenuItem x:Name="CheckoutCommitMenuItem"
                              Header="Checkout this commit"
                              Click="CtxCheckout_Click" />
                    <MenuItem x:Name="CheckoutBranchMenuItem"
                              Header="Checkout branch"
                              Click="CtxCheckoutBranch_Click" />
                    <MenuItem x:Name="CheckoutRemoteBranchMenuItem"
                              Header="Checkout remote branch as local"
                              Click="CtxCheckoutRemoteBranch_Click" />
                    <Separator />
                    <MenuItem x:Name="MergeRefMenuItem"
                              Header="Merge into current branch"
                              Click="CtxMergeRef_Click" />
                    <MenuItem x:Name="RebaseRefMenuItem"
                              Header="Rebase current branch onto this"
                              Click="CtxRebaseRef_Click" />
                    <Separator />
                    <MenuItem x:Name="RenameBranchMenuItem"
                              Header="Rename branch"
                              Click="CtxRenameBranch_Click" />
                    <MenuItem x:Name="DeleteBranchMenuItem"
                              Header="Delete branch"
                              Click="CtxDeleteBranch_Click" />
                    <MenuItem x:Name="DeleteRemoteBranchMenuItem"
                              Header="Delete remote branch"
                              Click="CtxDeleteRemoteBranch_Click" />
                    <MenuItem x:Name="DeleteTagMenuItem"
                              Header="Delete tag"
                              Click="CtxDeleteTag_Click" />
                    <MenuItem x:Name="PushBranchMenuItem"
                              Header="Push branch"
                              Click="CtxPushBranch_Click" />
                    <Separator />
                    <MenuItem x:Name="CherryPickCommitMenuItem"
                              Header="Cherry-pick…"
                              Click="CtxCherryPick_Click" />
                    <MenuItem x:Name="RevertCommitMenuItem"
                              Header="Revert…"
                              Click="CtxRevert_Click" />
                    <Separator />
                    <MenuItem x:Name="CreateBranchMenuItem"
                              Header="Create Branch here…"
                              Click="CtxCreateBranch_Click" />
                    <MenuItem x:Name="CreateBranchAtRefMenuItem"
                              Header="Create Branch at ref…"
                              Click="CtxCreateBranchAtRef_Click" />
                    <MenuItem x:Name="CreateTagMenuItem"
                              Header="Create Tag here…"
                              Click="CtxCreateTag_Click" />
                    <Separator />
                    <MenuItem x:Name="ResetHardMenuItem"
                              Header="Reset to this (hard)"
                              Click="CtxResetHard_Click" />
                    <Separator />
                    <MenuItem x:Name="InteractiveRebaseMenuItem"
                              Header="Interactive Rebase from here…"
                              Click="CtxInteractiveRebase_Click" />
                    <Separator />
                    <MenuItem x:Name="CopyShortHashMenuItem"
                              Header="Copy short hash"
                              Click="CtxCopyShortHash_Click" />
                    <MenuItem x:Name="CopyFullHashMenuItem"
                              Header="Copy full hash"
                              Click="CtxCopyFullHash_Click" />
                    <MenuItem x:Name="CopySubjectMenuItem"
                              Header="Copy subject"
                              Click="CtxCopySubject_Click" />
                    <MenuItem x:Name="CopyCommitSummaryMenuItem"
                              Header="Copy commit summary line"
                              Click="CtxCopyCommitSummary_Click" />
                    <MenuItem x:Name="CopyRefNameMenuItem"
                              Header="Copy ref name"
                              Click="CtxCopyRefName_Click" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:RevisionRow">
                    <Grid Height="18"
                          ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding $parent[local:RevisionDataGrid].GraphColWidth}" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{Binding $parent[local:RevisionDataGrid].AuthorColWidth}" />
                            <ColumnDefinition Width="{Binding $parent[local:RevisionDataGrid].DateColWidth}" />
                            <ColumnDefinition Width="{Binding $parent[local:RevisionDataGrid].HashColWidth}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="5"
                                Background="{Binding RowBackground}" />

                        <!-- Graph column -->
                        <local:GraphCell Grid.Column="0"
                                         Row="{Binding GraphRow}"
                                         PrevRow="{Binding PrevRow}"
                                         NextRow="{Binding NextRow}"
                                         Height="18" />

                        <!-- Subject: colored ref badges + message text -->
                        <Grid Grid.Column="1"
                              ColumnDefinitions="Auto,*"
                              ClipToBounds="True"
                              Margin="4,0"
                              VerticalAlignment="Center">
                            <ItemsControl Grid.Column="0"
                                          ItemsSource="{Binding Refs}"
                                          Margin="0,0,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="git:IGitRef">
                                        <Border Background="{Binding ., Converter={StaticResource RefTypeBrush}}"
                                                CornerRadius="2"
                                                Padding="3,1">
                                            <TextBlock Text="{Binding LocalName}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Subject}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       FontWeight="{Binding IsCurrent, Converter={StaticResource BoolToFontWeight}}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource RevisionRowTextBrush}">
                                        <Binding Path="IsRelativeToCurrentBranch" />
                                        <Binding Path="$parent[ListBoxItem].IsSelected" />
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Grid>

                        <!-- Author column -->
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Author}"
                                   VerticalAlignment="Center"
                                   Margin="4,0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource RevisionRowTextBrush}">
                                    <Binding Path="IsRelativeToCurrentBranch" />
                                    <Binding Path="$parent[ListBoxItem].IsSelected" />
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- Date column: relative age -->
                        <TextBlock Grid.Column="3"
                                   Text="{Binding RelativeDate}"
                                   VerticalAlignment="Center"
                                   Margin="4,0"
                                   FontSize="11">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource RevisionRowTextBrush}">
                                    <Binding Path="IsRelativeToCurrentBranch" />
                                    <Binding Path="$parent[ListBoxItem].IsSelected" />
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- Hash column: 7-char monospace, adaptive gray -->
                        <TextBlock Grid.Column="4"
                                   Text="{Binding ShortHash}"
                                   VerticalAlignment="Center"
                                   Margin="4,0"
                                   FontSize="11"
                                   FontFamily="{DynamicResource MonospaceFont}">
                            <TextBlock.Foreground>
                                <MultiBinding Converter="{StaticResource RevisionRowTextBrush}"
                                              ConverterParameter="hash">
                                    <Binding Path="IsRelativeToCurrentBranch" />
                                    <Binding Path="$parent[ListBoxItem].IsSelected" />
                                </MultiBinding>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
