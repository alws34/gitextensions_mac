<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.UpdatesDialog"
                            Title="Check for Updates" Width="420">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock x:Name="CurrentVersionLabel"/>
    <TextBlock x:Name="LatestVersionLabel" Text="Checking for updates..."/>
    <TextBlock x:Name="StatusLabel"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Check Now" Click="Check_Click"/>
      <Button Content="Close" Click="Close_Click"/>
    </StackPanel>
  </StackPanel>
</local:GitExtensionsDialog>
