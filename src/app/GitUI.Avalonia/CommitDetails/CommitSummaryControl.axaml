<local:GitModuleControl xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:GitUI.Avalonia.Base"
                         xmlns:git="using:GitExtensions.Extensibility.Git"
                         xmlns:converters="using:GitUI.Avalonia.Converters"
                         x:Class="GitUI.Avalonia.CommitDetails.CommitSummaryControl">
    <Border Background="{DynamicResource SystemChromeMediumLowColor}"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
            BorderThickness="0,0,0,1">
        <Grid Margin="8,6,8,6"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              ColumnDefinitions="Auto,*">
            <!-- Hash + ref badges on the same row -->
            <StackPanel Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock x:Name="CommitHash"
                           FontFamily="{DynamicResource MonospaceFont}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           VerticalAlignment="Center" />
                <ItemsControl x:Name="RefLabels" IsVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="git:IGitRef">
                            <Border Background="{Binding ., Converter={StaticResource RefTypeBrush}}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    Margin="0,0,4,2">
                                <TextBlock Text="{Binding LocalName}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <!-- Commit subject -->
            <TextBlock x:Name="CommitMessage"
                       Grid.Row="1"
                       Grid.ColumnSpan="2"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Margin="0,3,0,3"
                       MaxLines="2"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis" />
            <!-- Author row -->
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Author:"
                       FontWeight="SemiBold"
                       FontSize="11"
                       Margin="0,0,4,0"
                       Foreground="{DynamicResource SystemBaseMediumColor}" />
            <TextBlock x:Name="AuthorName"
                       Grid.Row="2"
                       Grid.Column="1"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
            <!-- Date row -->
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Date:"
                       FontWeight="SemiBold"
                       FontSize="11"
                       Margin="0,0,4,0"
                       Foreground="{DynamicResource SystemBaseMediumColor}" />
            <TextBlock x:Name="AuthorDate"
                       Grid.Row="3"
                       Grid.Column="1"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis" />
            <!-- Commit body (only shown when present) -->
            <ScrollViewer x:Name="BodyScroll"
                          Grid.Row="4"
                          Grid.ColumnSpan="2"
                          MaxHeight="52"
                          IsVisible="False"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="CommitBody"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
            </ScrollViewer>
        </Grid>
    </Border>
</local:GitModuleControl>
