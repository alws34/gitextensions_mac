<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
                            x:Class="GitUI.Avalonia.Dialogs.FileHistoryDialog"
                            Title="File History" Width="900" Height="700">
  <Grid RowDefinitions="*,*">
    <ListBox Grid.Row="0" x:Name="CommitsList" SelectionChanged="CommitsList_SelectionChanged"/>
    <ae:TextEditor Grid.Row="1" x:Name="FileEditor" IsReadOnly="True"/>
  </Grid>
</local:GitExtensionsDialog>
