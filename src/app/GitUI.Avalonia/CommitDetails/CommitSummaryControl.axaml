<local:GitModuleControl xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:local="using:GitUI.Avalonia.Base"
                         xmlns:git="using:GitExtensions.Extensibility.Git"
                         xmlns:converters="using:GitUI.Avalonia.Converters"
                         x:Class="GitUI.Avalonia.CommitDetails.CommitSummaryControl">
    <Border Background="{DynamicResource SystemChromeMediumLowColor}"
            BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
            BorderThickness="0,0,0,1">
        <StackPanel Margin="8,6,8,6" Spacing="3">
            <!-- Hash + ref badges on the same row -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="CommitHash"
                           FontFamily="{DynamicResource MonospaceFont}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           VerticalAlignment="Center" />
                <ItemsControl x:Name="RefLabels" IsVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="git:IGitRef">
                            <Border Background="{Binding ., Converter={StaticResource RefTypeBrush}}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    Margin="0,0,4,2">
                                <TextBlock Text="{Binding LocalName}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <!-- Commit subject -->
            <TextBlock x:Name="CommitMessage"
                       FontWeight="SemiBold"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <!-- Author row -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Author:"
                           FontWeight="SemiBold"
                           FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <TextBlock x:Name="AuthorName"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <!-- Date row -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Date:"
                           FontWeight="SemiBold"
                           FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <TextBlock x:Name="AuthorDate"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           FontSize="11" />
            </StackPanel>
            <!-- Commit body (only shown when present) -->
            <ScrollViewer x:Name="BodyScroll"
                          MaxHeight="52"
                          IsVisible="False"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="CommitBody"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
            </ScrollViewer>
        </StackPanel>
    </Border>
</local:GitModuleControl>
