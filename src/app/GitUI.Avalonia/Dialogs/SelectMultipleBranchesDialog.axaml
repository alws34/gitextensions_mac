<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.SelectMultipleBranchesDialog"
                            Title="Select Branches" Width="400" Height="500">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Click="OK_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Select branches:" Margin="0,0,0,8"/>
        <ListBox x:Name="BranchesList" SelectionMode="Multiple"/>
    </DockPanel>
</local:GitExtensionsDialog>
