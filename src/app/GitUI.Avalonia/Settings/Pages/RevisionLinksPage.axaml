<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.Avalonia.Settings.Pages.RevisionLinksPage">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="Revision Links" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="Revision link definitions XML:"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <TextBox Grid.Row="2"
                 x:Name="RevisionLinkDefsTextBox"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Menlo"
                 FontSize="12"
                 Margin="0,0,0,8"
                 Watermark="Leave empty when no revision links are configured." />
        <TextBlock Grid.Row="3"
                   Text="The Windows settings page stores these definitions as RevisionLinkDefs."
                   FontSize="11"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
