<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.ReflogDialog"
                            Title="Reflog" Width="700" Height="450">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ListBox Grid.Row="0" x:Name="ReflogGrid" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Checkout Selected" Click="Checkout_Click" />
            <Button Content="Close" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</local:GitExtensionsDialog>
