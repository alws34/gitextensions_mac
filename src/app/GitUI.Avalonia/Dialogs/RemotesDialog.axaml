<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.RemotesDialog"
                            Title="Manage Remotes" Width="580" Height="420">
    <Grid ColumnDefinitions="200,8,*" Margin="16">
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="0,8,0,0">
                <Button Content="Add" Click="AddRemote_Click" />
                <Button Content="Remove" Click="RemoveRemote_Click" />
            </StackPanel>
            <ListBox x:Name="RemotesList" SelectionChanged="Remote_Selected" />
        </DockPanel>
        <DockPanel Grid.Column="2">
            <Button DockPanel.Dock="Bottom" Content="Close" Click="Cancel_Click"
                    HorizontalAlignment="Right" Margin="0,8,0,0" />
            <StackPanel Spacing="8">
                <TextBlock Text="Name:" />
                <TextBox x:Name="RemoteNameTextBox" />
                <TextBlock Text="Fetch URL:" />
                <TextBox x:Name="RemoteUrlTextBox" />
                <Button Content="Save" Click="SaveRemote_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</local:GitExtensionsDialog>
