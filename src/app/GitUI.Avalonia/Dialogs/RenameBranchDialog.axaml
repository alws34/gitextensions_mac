<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.RenameBranchDialog"
                            Title="Rename Branch" Width="400">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Current branch:" />
        <ComboBox x:Name="OldNameComboBox" HorizontalAlignment="Stretch" />
        <TextBlock Text="New name:" />
        <TextBox x:Name="NewNameTextBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Rename" IsDefault="True" Click="OK_Click" />
        </StackPanel>
    </StackPanel>
</local:GitExtensionsDialog>
