<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.CloneDialog"
                            Title="Clone Repository" Width="550">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Source URL:" />
        <TextBox x:Name="UrlTextBox" />
        <TextBlock Text="Destination path:" />
        <Grid ColumnDefinitions="*,4,Auto">
            <TextBox Grid.Column="0" x:Name="DestPathTextBox" />
            <Button Grid.Column="2" Content="Browse..." Click="BrowseDest_Click" />
        </Grid>
        <TextBlock Text="Branch (optional):" />
        <TextBox x:Name="BranchTextBox" />
        <TextBlock x:Name="StatusTextBlock" Text="" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Clone" IsDefault="True" Click="Clone_Click" />
        </StackPanel>
    </StackPanel>
</local:GitExtensionsDialog>
