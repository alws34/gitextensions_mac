<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.Avalonia.Settings.Pages.GeneralPage">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="General" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />

            <CheckBox x:Name="OpenLastRepositoryCheckBox"
                      Content="Open last repository on startup" />

            <StackPanel Spacing="4">
                <TextBlock Text="Recent repositories to keep:" />
                <NumericUpDown x:Name="RecentRepositoryLimitBox"
                               Minimum="1"
                               Maximum="50"
                               Increment="1" />
            </StackPanel>

            <CheckBox x:Name="UseNativeMenuCheckBox"
                      Content="Use macOS native menu bar on startup" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
