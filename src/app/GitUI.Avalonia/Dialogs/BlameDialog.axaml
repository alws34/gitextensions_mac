<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
                            x:Class="GitUI.Avalonia.Dialogs.BlameDialog"
                            Title="Blame" Width="1100" Height="700">
  <Grid ColumnDefinitions="280,*">
    <ListBox Grid.Column="0" x:Name="BlameList" FontFamily="Monospace"/>
    <ae:TextEditor Grid.Column="1" x:Name="BlameEditor" IsReadOnly="True"/>
  </Grid>
</local:GitExtensionsDialog>
