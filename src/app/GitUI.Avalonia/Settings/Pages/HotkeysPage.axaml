<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.Avalonia.Settings.Pages.HotkeysPage">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="Hotkeys" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="Stored hotkey overrides XML:"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <TextBox Grid.Row="2"
                 x:Name="SerializedHotkeysTextBox"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Menlo"
                 FontSize="12"
                 Margin="0,0,0,8"
                 Watermark="Leave empty to use default hotkeys." />
        <Button Grid.Row="3"
                Content="Reset to defaults"
                Click="Reset_Click"
                HorizontalAlignment="Left"
                Padding="8,3" />
    </Grid>
</UserControl>
