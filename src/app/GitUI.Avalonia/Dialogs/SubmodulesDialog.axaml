<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.SubmodulesDialog"
                            Title="Manage Submodules" Width="620" Height="400">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <ListBox Grid.Row="0" x:Name="SubmodulesGrid" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Update All" Click="UpdateAll_Click" />
            <Button Content="Sync" Click="Sync_Click" />
            <Button Content="Add..." Click="Add_Click" />
            <Button Content="Close" Click="Cancel_Click" HorizontalAlignment="Right" />
        </StackPanel>
    </Grid>
</local:GitExtensionsDialog>
