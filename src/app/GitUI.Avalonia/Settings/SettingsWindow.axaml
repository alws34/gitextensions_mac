<local:GitExtensionsWindow xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:local="using:GitUI.Avalonia.Base"
                           x:Class="GitUI.Avalonia.Settings.SettingsWindow"
                           Title="Settings" Width="720" Height="520">
    <Grid ColumnDefinitions="180,4,*" Margin="8">
        <Border Grid.Column="0" BorderBrush="{DynamicResource SystemBaseMediumColor}" BorderThickness="1">
            <ListBox x:Name="CategoryList" SelectionChanged="Category_Changed">
                <ListBoxItem Content="Git" Tag="git" IsSelected="True" />
                <ListBoxItem Content="Appearance" Tag="appearance" />
                <ListBoxItem Content="Commit" Tag="commit" />
                <ListBoxItem Content="Advanced" Tag="advanced" />
            </ListBox>
        </Border>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
        <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                <Button Content="Cancel" Click="Cancel_Click" />
                <Button Content="Save" IsDefault="True" Click="Save_Click" />
            </StackPanel>
            <ContentControl x:Name="PageContent" Margin="8,0,0,0" />
        </DockPanel>
    </Grid>
</local:GitExtensionsWindow>
