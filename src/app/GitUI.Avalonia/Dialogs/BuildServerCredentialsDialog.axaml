<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:local="using:GitUI.Avalonia.Base"
                           x:Class="GitUI.Avalonia.Dialogs.BuildServerCredentialsDialog"
                           Title="Build Server Credentials" Width="420">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Text="Build Server URL:"/>
    <TextBox x:Name="UrlBox"/>
    <TextBlock Text="Username:"/>
    <TextBox x:Name="UsernameBox"/>
    <TextBlock Text="Password:"/>
    <TextBox x:Name="PasswordBox" PasswordChar="*"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
      <Button Content="Save" Click="Save_Click"/>
      <Button Content="Cancel" Click="Cancel_Click"/>
    </StackPanel>
  </StackPanel>
</local:GitExtensionsDialog>
