<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.Avalonia.Settings.Pages.ScriptsPage">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="Scripts" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1"
                   Text="User scripts XML:"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />
        <TextBox Grid.Row="2"
                 x:Name="OwnScriptsTextBox"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Menlo"
                 FontSize="12"
                 Margin="0,0,0,8"
                 Watermark="Paste or edit the saved script definitions." />
        <TextBlock Grid.Row="3"
                   Text="Arguments can use tokens such as {WorkingDir}, {sHash}, {sBranch}, and {SelectedRelativePaths}."
                   FontSize="11"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
