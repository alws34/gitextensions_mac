<local:GitExtensionsDialog xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:local="using:GitUI.Avalonia.Base"
                            x:Class="GitUI.Avalonia.Dialogs.CheckoutBranchDialog"
                            Title="Checkout Branch" Width="450">
    <StackPanel Margin="16" Spacing="8">
        <TextBlock Text="Branch:" />
        <ComboBox x:Name="BranchComboBox" HorizontalAlignment="Stretch" />
        <CheckBox x:Name="CreateNewBranchCheckBox"
                  Content="Create new branch"
                  IsCheckedChanged="CreateNewBranch_IsCheckedChanged" />
        <TextBlock Text="New branch name:" IsVisible="{Binding #NewBranchPanel.IsVisible}" />
        <StackPanel x:Name="NewBranchPanel" IsVisible="False">
            <TextBox x:Name="NewBranchNameTextBox" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button Content="Cancel" Click="Cancel_Click" />
            <Button Content="Checkout" IsDefault="True" Click="OK_Click" />
        </StackPanel>
    </StackPanel>
</local:GitExtensionsDialog>
